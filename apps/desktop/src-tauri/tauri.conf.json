{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Molibot",
  "version": "0.9.58",
  "identifier": "com.eztoolab.molibot",
  "build": {
    "beforeDevCommand": "corepack pnpm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "corepack pnpm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "chat",
        "title": "Molibot",
        "url": "index.html?window=chat",
        "width": 1120,
        "height": 760,
        "minWidth": 720,
        "minHeight": 520,
        "center": true,
        "transparent": true,
        "windowEffects": {
          "effects": [
            "sidebar"
          ],
          "state": "followsWindowActiveState",
          "radius": 0
        },
        "titleBarStyle": "Overlay",
        "trafficLightPosition": {
          "x": 18,
          "y": 22
        },
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data: blob: http://127.0.0.1:* http://localhost:* molibot-artifact: http://molibot-artifact.localhost; media-src 'self' blob: http://127.0.0.1:* http://localhost:*; style-src 'self' 'unsafe-inline'; frame-src molibot-miniapp: http://molibot-miniapp.localhost molibot-artifact: http://molibot-artifact.localhost molibot-plugin: http://molibot-plugin.localhost"
    }
  },
  "bundle": {
    "active": false,
    "targets": [
      "dmg"
    ],
    "category": "Productivity",
    "createUpdaterArtifacts": true,
    "copyright": "Copyright © 2026 EZTOOLAB",
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ0NTdBNTRFQTg3NTJFQ0UKUldUT0xuV29UcVZYUkd2SUlGS3Z3SlFsOFlsYzM2aUtIdmJTUEJUR3VkOWc3bDhhMkx2NTZQWnkK",
      "endpoints": [
        "https://github.com/gusibi/molibot/releases/latest/download/latest.json"
      ]
    }
  }
}

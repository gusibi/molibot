registry=https://registry.npmjs.org/

# pnpm's pre-run deps check otherwise auto-spawns `pnpm install` by bare name,
# which fails with ENOENT under `make`/`sh` (where the Corepack `pnpm` shim is
# not resolvable on PATH). `warn` keeps the out-of-date signal but never spawns
# a child install, so `make desktop-dev` and the nested `corepack pnpm` calls run.
verify-deps-before-run=warn

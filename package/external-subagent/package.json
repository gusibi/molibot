{
  "name": "@molibot/external-subagent",
  "version": "0.3.0",
  "description": "External Subagent runtime and adapters for Codex and Claude Code",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "private": true,
  "molibot": {
    "plugin": {
      "manifestVersion": 1,
      "id": "external-subagent",
      "name": "External Subagent",
      "version": "0.3.0",
      "description": "Run OpenAI Codex and Claude Code as standalone external subagents",
      "engines": {
        "molibot": ">=2.0.0"
      },
      "config": {
        "schemaVersion": 1
      },
      "runtime": {
        "entry": "dist/runtime.mjs",
        "actions": [
          "detectEnvironment",
          "installProvider",
          "testProvider"
        ]
      },
      "capabilities": [
        "spawn",
        "network"
      ],
      "settings": {
        "mode": "custom",
        "schema": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "codexEnabled": {
              "type": "boolean"
            },
            "codexPath": {
              "type": "string"
            },
            "claudeCodeEnabled": {
              "type": "boolean"
            },
            "claudeCodePath": {
              "type": "string"
            }
          }
        },
        "ui": {
          "entry": "ui/index.html"
        }
      }
    }
  }
}
